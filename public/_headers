# Cloudflare Pages response headers. Static files are cached briefly by browsers
# and served stale while revalidating, so repeat visits don't wait on the network.
# The /api/* functions set their own Cache-Control.

/*
  Cache-Control: public, max-age=300, stale-while-revalidate=86400
  X-Content-Type-Options: nosniff

/data/*
  Cache-Control: public, max-age=600, stale-while-revalidate=604800
